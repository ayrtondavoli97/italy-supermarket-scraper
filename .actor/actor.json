{
  "actorSpecification": 1,
  "name": "italy-supermarket-scraper",
  "title": "Italy Supermarket Scraper \u2014 Esselunga Prices & Products",
  "description": "Scrape product prices from Esselunga online grocery store. Filter by category or search query. Returns name, price, price/kg, brand, promotions, and more.",
  "version": "1.0",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Supermarket Products",
      "views": {
        "overview": {
          "title": "Products",
          "transformation": {
            "fields": [
              "supermarket",
              "categoria",
              "name",
              "brand",
              "weight",
              "price",
              "pricePerKg",
              "oldPrice",
              "promo",
              "url",
              "img"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "supermarket": {
                "label": "Supermercato",
                "format": "text"
              },
              "categoria": {
                "label": "Categoria",
                "format": "text"
              },
              "name": {
                "label": "Nome Prodotto",
                "format": "text"
              },
              "brand": {
                "label": "Marca",
                "format": "text"
              },
              "weight": {
                "label": "Peso/Quantit\u00e0",
                "format": "text"
              },
              "price": {
                "label": "Prezzo \u20ac",
                "format": "text"
              },
              "pricePerKg": {
                "label": "\u20ac/Kg",
                "format": "text"
              },
              "oldPrice": {
                "label": "Prezzo Originale \u20ac",
                "format": "text"
              },
              "promo": {
                "label": "Promozione",
                "format": "text"
              },
              "url": {
                "label": "Link",
                "format": "link"
              },
              "img": {
                "label": "Immagine",
                "format": "image"
              }
            }
          }
        }
      }
    }
  },
  "defaultRunOptions": {
    "timeoutSecs": 600,
    "memoryMbytes": 1024
  }
}