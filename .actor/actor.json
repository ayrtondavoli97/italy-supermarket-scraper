{
    "actorSpecification": 1,
    "name": "italy-supermarket-deals-scraper",
    "title": "Italian Supermarket Flyers & Deals Scraper",
    "description": "Extract current promotional products from Italian grocery flyers. Structured API-quality extraction is validated for Conad Superstore, Lidl, Eurospin, MD Discount and Aldi; Famila and iN's Mercato are included for validation; Esselunga fallback records are optional. Returns prices, numeric price values, validity dates, flyer references and quality metadata.",
    "version": "1.3",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 900,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Supermarket Promotional Offers",
            "views": {
                "overview": {
                    "title": "Current Deals",
                    "transformation": {
                        "fields": ["name", "catena", "chainSlug", "priceOfferValue", "currency", "format", "validFrom", "validTo", "dataQuality", "flyerId", "pageNumber", "offerId", "img", "sourcePageUrl", "scrapedAt"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "name": { "label": "Product", "format": "text" },
                            "catena": { "label": "Chain", "format": "text" },
                            "chainSlug": { "label": "Chain slug", "format": "text" },
                            "priceOfferValue": { "label": "Offer price", "format": "number" },
                            "currency": { "label": "Currency", "format": "text" },
                            "format": { "label": "Size / format", "format": "text" },
                            "validFrom": { "label": "Valid from", "format": "text" },
                            "validTo": { "label": "Valid to", "format": "text" },
                            "dataQuality": { "label": "Data quality", "format": "text" },
                            "flyerId": { "label": "Flyer ID", "format": "text" },
                            "pageNumber": { "label": "Page", "format": "text" },
                            "offerId": { "label": "Offer ID", "format": "text" },
                            "img": { "label": "Flyer image", "format": "image" },
                            "sourcePageUrl": { "label": "Source page", "format": "link" },
                            "scrapedAt": { "label": "Scraped at", "format": "text" }
                        }
                    }
                }
            }
        }
    }
}
