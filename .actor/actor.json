{
    "actorSpecification": 1,
    "name": "italy-supermarket-deals-scraper",
    "title": "Italian Supermarket Flyers & Deals Scraper",
    "description": "Extracts current promotional products from Italian supermarket flyers. Structured offer extraction currently works for Lidl, Eurospin, MD Discount and Aldi, with explicitly marked fallback coverage where available. Returns prices, validity dates, flyer/page references, source quality and extraction timestamp.",
    "version": "1.1",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 600,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Supermarket Promotional Offers",
            "views": {
                "overview": {
                    "title": "Current Deals",
                    "transformation": {
                        "fields": ["name", "catena", "chainSlug", "priceOffer", "priceOriginal", "discount", "format", "validFrom", "validTo", "dataQuality", "flyerId", "pageNumber", "offerId", "img", "sourcePageUrl", "scrapedAt"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "name": { "label": "Product", "format": "text" },
                            "catena": { "label": "Chain", "format": "text" },
                            "chainSlug": { "label": "Chain slug", "format": "text" },
                            "priceOffer": { "label": "Offer price €", "format": "text" },
                            "priceOriginal": { "label": "Original price €", "format": "text" },
                            "discount": { "label": "Discount", "format": "text" },
                            "format": { "label": "Size / format", "format": "text" },
                            "validFrom": { "label": "Valid from", "format": "text" },
                            "validTo": { "label": "Valid to", "format": "text" },
                            "dataQuality": { "label": "Data quality", "format": "text" },
                            "flyerId": { "label": "Flyer ID", "format": "text" },
                            "pageNumber": { "label": "Page", "format": "text" },
                            "offerId": { "label": "Offer ID", "format": "text" },
                            "img": { "label": "Flyer image", "format": "image" },
                            "sourcePageUrl": { "label": "Source page", "format": "link" },
                            "scrapedAt": { "label": "Scraped at", "format": "text" }
                        }
                    }
                }
            }
        }
    }
}
