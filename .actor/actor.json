{
    "actorSpecification": 1,
    "name": "italy-supermarket-deals-scraper",
    "title": "Italy Supermarket Deals Scraper — Weekly Offers & Discounts",
    "description": "Scrapes current weekly deals and promotions from all major Italian supermarkets (Esselunga, Conad, Lidl, Eurospin, Carrefour, Coop, MD, Penny, Aldi, Bennet and more) via VolantinoFacile.it. Returns product name, offer price, original price, discount %, chain, validity dates.",
    "version": "1.0",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 300,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Supermarket Deals",
            "views": {
                "overview": {
                    "title": "Deals",
                    "transformation": {
                        "fields": ["name","catena","categoria","priceOffer","priceOriginal","discount","validity","img","url"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "name":          { "label": "Prodotto",          "format": "text" },
                            "catena":        { "label": "Catena",            "format": "text" },
                            "categoria":     { "label": "Categoria",         "format": "text" },
                            "priceOffer":    { "label": "Prezzo Offerta €",  "format": "text" },
                            "priceOriginal": { "label": "Prezzo Originale €","format": "text" },
                            "discount":      { "label": "Sconto",            "format": "text" },
                            "validity":      { "label": "Validità",          "format": "text" },
                            "img":           { "label": "Immagine",          "format": "image" },
                            "url":           { "label": "Link",              "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
