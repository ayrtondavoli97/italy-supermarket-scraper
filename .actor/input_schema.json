{
    "title": "Italy Supermarket Deals Scraper",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "catena": {
            "title": "Catena supermercato",
            "type": "string",
            "description": "Seleziona la catena da scrapare. 'tutti' per tutte le catene.",
            "editor": "select",
            "enum": ["tutti","esselunga","conad","coop","lidl","eurospin","carrefour","penny","md","aldi","bennet","iper","pam","despar","famila"],
            "enumTitles": ["Tutte le catene","Esselunga","Conad","Coop","Lidl","Eurospin","Carrefour","Penny Market","MD Discount","Aldi","Bennet","Iper","Pam","Despar","Famila"],
            "default": "tutti"
        },
        "categoria": {
            "title": "Categoria prodotto (opzionale)",
            "type": "string",
            "description": "Filtra per categoria (es. 'pasta', 'bevande', 'carne')",
            "editor": "textfield",
            "default": ""
        },
        "maxItems": {
            "title": "Max offerte",
            "type": "integer",
            "description": "Numero massimo di offerte da restituire",
            "default": 500,
            "minimum": 1,
            "maximum": 10000
        },
        "proxyConfig": {
            "title": "Proxy configuration",
            "type": "object",
            "description": "Configurazione proxy Apify",
            "editor": "proxy",
            "default": {"useApifyProxy": true}
        }
    }
}
